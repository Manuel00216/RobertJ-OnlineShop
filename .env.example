# Copy to .env.local and fill in your Supabase project values.
#   cp .env.example .env.local
# Find these in the Supabase dashboard under Project Settings → API.
# Restart the dev server after editing.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of this app. Used to build auth email redirect links
# (email verification, password recovery). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — bypasses Row Level Security. Leave blank unless a trusted
# server job needs it (e.g. a future payment webhook). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
