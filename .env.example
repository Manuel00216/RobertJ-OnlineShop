# RoberJ Online Shop — environment template
# Copy to .env.local and fill in your values:  cp .env.example .env.local
# Validated at startup by src/config/env.ts (the app fails fast if misconfigured).

# --- Supabase (required) ---
# Find these in your Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trusted server-side jobs only. Never expose to the client. (optional)
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (EXPERIMENTAL SPIKE — not the official capstone payment path, optional) ---
# The SAD payment path is COD + QR receipt upload + manual verification.
# These keys are OPTIONAL: the app boots on Supabase credentials alone.
# Leave them blank to run without card payments (Checkout offers COD only);
# fill them in to enable the Stripe spike. See README.md → Implementation
# Status and ARCHITECTURE.md → Technical Debt (TD-3).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
